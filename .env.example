# NAVIC-TRACK Project Root Environment Variables

# Mock Tracker Server
PORT=8080
TRACKER_AUTH_TOKEN=navic-secret-token-123

# Web Dashboard
NEXT_PUBLIC_TRACKER_URL=http://localhost:8080
NEXT_PUBLIC_TRACKER_WS_URL=ws://localhost:8080/ws

# OpenJarvis AI Flight Director & Gemini Configuration
JARVIS_SERVICE_URL=http://127.0.0.1:8100
GEMINI_API_KEY=your_gemini_api_key_here
JARVIS_MODEL=gemini-3.5-flash

